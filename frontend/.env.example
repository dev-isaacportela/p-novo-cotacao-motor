# Auto-populado pelo servidor (sandbox do Mitra) — NÃO hardcode valores.
# Toda VITE_* vai para o bundle público: nunca coloque token aqui.
VITE_MITRA_AUTH_URL=
VITE_MITRA_PROJECT_ID=

# Opcional — só para o simulador local (backend/simulator).
# Se VITE_MITRA_AUTH_URL estiver vazio, o app entra em modo local sozinho,
# apontando para a porta definida em frontend/src/lib/mitra-auth.ts.
VITE_MITRA_BASE_URL=
